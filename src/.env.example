# ============================================
# ProjectHub Environment Configuration
# ============================================

# --------------------------------------------
# Required for System Bootstrap
# --------------------------------------------
AUTO_REGISTER_DOMAIN=example.com
ADMIN_USERS=admin@example.com,manager@example.com

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/projecthub?schema=public

# --------------------------------------------
# Authentication
# --------------------------------------------
# Better Auth will use this as the base URL
BETTER_AUTH_SECRET=your-random-secret-key-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Public-facing app URL (used for client-side auth and email links)
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Email verification (set to true in production)
REQUIRE_EMAIL_VERIFICATION=false

# Email Configuration (for OTP)
# Using Mailtrap SMTP for development
EMAIL_PROVIDER=smtp
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-user-id
EMAIL_PASS=your-mailtrap-password
EMAIL_FROM=hello@example.com
EMAIL_SECURE=false

# --------------------------------------------
# AI Services (OpenAI)
# --------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# --------------------------------------------
# Mailtrap Sandbox (Development)
# --------------------------------------------
MAILTRAP_API_TOKEN=your-actual-mailtrap-api-token-here
MAILTRAP_SEND_ENDPOINT=https://sandbox.api.mailtrap.io/api/send/your-inbox-id
MAILTRAP_SENDER_EMAIL=hello@example.com
MAILTRAP_SENDER_NAME=ProjectHub Dev

# Legacy SMTP fallback (optional)
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_FROM=
# EMAIL_SECURE=false

# --------------------------------------------
# Optional: OAuth Providers
# --------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# --------------------------------------------
# Optional: AWS S3 Storage (for production file uploads)
# --------------------------------------------
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# --------------------------------------------
# Additional Integrations (optional)
# --------------------------------------------
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
SCHEDULER_ACCESS_CODE=123456
DATA_ACCESS_CODE=123456
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET="" # Added by `npx auth`. Read more: https://cli.authjs.dev
